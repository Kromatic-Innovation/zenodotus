{
  "scope": {
    "patch": "diff",
    "minor": "diff",
    "major": "full"
  },
  "personas": [
    "drive-by-installer",
    "production-evaluator",
    "maintainers-maintainer"
  ],
  "prior_rulings": "on",
  "nit_bar": "strict",
  "disposition": {
    "bug": {
      "yes": { "action": "fix", "rerun": true, "labels": ["<type>", "moscow:<by-severity>"], "follow_up": "ready" },
      "no": { "action": "file", "rerun": false, "labels": ["<type>", "moscow:<by-severity>"], "follow_up": "ready" }
    },
    "doc-false": {
      "yes": { "action": "fix", "rerun": false, "labels": ["docs", "moscow:could"], "follow_up": "ready" },
      "no": { "action": "file", "rerun": false, "labels": ["docs", "moscow:could"], "follow_up": "ready" }
    },
    "doc-nit": {
      "yes": { "action": "fix-if-trivial", "rerun": false, "labels": ["docs", "moscow:wont"], "follow_up": "wont-ready" },
      "no": { "action": "drop", "rerun": false, "labels": [], "follow_up": null }
    },
    "feature": {
      "yes": { "action": "file", "rerun": false, "labels": ["feature", "~planning"], "follow_up": "planning" },
      "no": { "action": "file", "rerun": false, "labels": ["feature", "~planning"], "follow_up": "planning" }
    }
  },
  "trivial_fix_max_lines": 10,
  "rerun": {
    "scope": "fix-diff",
    "max": 1
  },
  "cli": {}
}
